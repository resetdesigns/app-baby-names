rules_version = '2';

// Baby Names app: only swipe documents inside a room can be used. Everything else is locked.
// There is no login, so the room code is the shared secret. Choose one that is hard to guess.
service cloud.firestore {
  match /databases/{database}/documents {

    match /rooms/{room}/swipes/{swipeId} {
      function validRoom() {
        return room.matches('^[A-Z0-9_-]+$') && room.size() >= 3 && room.size() <= 24;
      }

      function validSwipe() {
        let d = request.resource.data;
        return d.keys().hasOnly(['user', 'userKey', 'name', 'liked', 'createdAt'])
          && d.keys().hasAll(['user', 'userKey', 'name', 'liked', 'createdAt'])
          && d.user is string && d.user.size() >= 1 && d.user.size() <= 20
          && d.userKey is string && d.userKey.size() >= 1 && d.userKey.size() <= 20
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 40
          && d.liked is bool
          && d.createdAt == request.time
          && swipeId == d.userKey + '__' + d.name;
      }

      allow read: if validRoom();
      allow create, update: if validRoom() && validSwipe();
      allow delete: if validRoom();
    }

    // Anything else (including the old connectionTest collection) is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
